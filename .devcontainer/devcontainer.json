{
  "name": "Personal Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      // 构建参数具体含义见 Dockerfile 注释。
      "USERNAME": "dev"
    }
  },
  "containerUser": "dev",
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "workspaceMount": "source=${localEnv:HOME}/workspace,target=/home/dev/workspace,type=bind",
  "workspaceFolder": "/home/dev/workspace",
  "mounts": [
    "source=/etc/localtime,target=/etc/localtime,type=bind,readonly"
  ],
  "init": true,
  "shutdownAction": "none"
}
