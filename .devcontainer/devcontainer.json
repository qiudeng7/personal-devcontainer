{
  "name": "Personal Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      // 每个构建参数的具体含义见 Dockerfile 中对应 ARG 的注释。
      "USERNAME": "${localEnv:USER}",
      "USER_UID": "1000",
      "USER_GID": "1000"
    }
  },
  "containerUser": "${localEnv:USER}",
  "remoteUser": "${localEnv:USER}",
  "updateRemoteUserUID": true,
  "workspaceMount": "source=${localEnv:HOME}/workspace,target=/home/${localEnv:USER}/workspace,type=bind",
  "workspaceFolder": "/home/${localEnv:USER}/workspace",
  "mounts": [
    "source=/etc/localtime,target=/etc/localtime,type=bind,readonly"
  ],
  "init": true,
  "shutdownAction": "none"
}
